diff --git a/Library/Homebrew/cmd/update.sh b/Library/Homebrew/cmd/update.sh
index 32a44651ee..e7bd21ac83 100644
--- a/Library/Homebrew/cmd/update.sh
+++ b/Library/Homebrew/cmd/update.sh
@@ -250,6 +250,24 @@ merge_or_rebase() {
   local UPSTREAM_BRANCH
 
   DIR="$1"
+
+  if [[ -d "/data/data/com.termux/files/usr/glibc" && "${DIR}" == "${HOMEBREW_REPOSITORY}" ]]
+  then
+    cd "${DIR}" || return
+    local termux_upstream_ref
+    termux_upstream_ref="$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null)"
+    [[ -z "${termux_upstream_ref}" ]] && termux_upstream_ref="origin/main"
+    if [[ -n "$(git log --oneline "${termux_upstream_ref}"..HEAD 2>/dev/null)" ]]
+    then
+      opoo "Skipping self-update of ${DIR}: local Termux compat commits present (would be discarded otherwise)."
+      local termux_skip_revision
+      termux_skip_revision="$(read_current_revision)"
+      export HOMEBREW_UPDATE_BEFORE"$2"="${termux_skip_revision}"
+      export HOMEBREW_UPDATE_AFTER"$2"="${termux_skip_revision}"
+      return
+    fi
+  fi
+
   cd "${DIR}" || return
   TAP_VAR="$2"
   UPSTREAM_BRANCH="$3"
